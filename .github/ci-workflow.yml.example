name: CI & Deployment Checks

on:
  push:
    branches: [ main, master ]
  pull_request:
    branches: [ main, master ]

jobs:
  validate:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: 20
          cache: 'npm'

      - name: Install dependencies
        run: npm ci

      - name: Run Vitest Automated Tests
        run: npm test

      - name: Typecheck TypeScript (Frontend & Worker)
        run: npm run typecheck

      - name: Build React SPA Bundle
        run: npm run build:frontend

      - name: Wrangler Config Check
        run: npx wrangler types
