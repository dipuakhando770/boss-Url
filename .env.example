# Boss URL Shortener Environment Variables Example

# App Identity
APP_NAME="Boss URL Shortener SaaS"
STAGE1_DOMAIN="https://urlshort.nasirdigitalhub.com"
STAGE2_API_URL="http://107.174.37.180/api/links/stage1"
ADMIN_PATH="/nachid/admin"

# Secrets (configured in Cloudflare using: wrangler secret put <NAME>)
JWT_SECRET="generate-a-strong-random-32-byte-hex-string-for-jwt"
BOOTSTRAP_SECRET="choose-a-strong-secret-phrase-to-bootstrap-initial-admin"

# Cloudflare D1
# Local: wrangler d1 migrations apply boss-url-db --local
# Remote: wrangler d1 migrations apply boss-url-db --remote
D1_DATABASE_ID="your-cloudflare-d1-database-uuid"
