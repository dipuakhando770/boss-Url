# Boss URL Shortener Environment Variables Example

# App Identity
APP_NAME="Boss URL Shortener SaaS"
STAGE1_DOMAIN="https://urlshort.nasirdigitalhub.com"
STAGE2_API_URL="https://boss-url.vercel.app/api/proxy/stage2" # or dedicated https://vps-api.nasirdigitalhub.com/api/links/stage1
ADMIN_PATH="/nachid/admin"

# Secrets (configured in Cloudflare using: wrangler secret put <NAME>)
JWT_SECRET="generate-a-strong-random-32-byte-hex-string-for-jwt"
BOOTSTRAP_SECRET="D12701392ddff"

# Cloudflare D1
# Local: wrangler d1 migrations apply boss-url-db-prod --local
# Remote: wrangler d1 migrations apply boss-url-db-prod --remote
D1_DATABASE_ID="6599be47-9a42-47eb-8d4d-ffeff9941b8f"
