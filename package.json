{
  "name": "boss-url-shortener",
  "version": "1.0.0",
  "private": true,
  "description": "Boss URL Shortener SaaS - Two-Stage Shortening Engine for Cloudflare Workers & D1",
  "type": "module",
  "scripts": {
    "dev:frontend": "vite",
    "dev:worker": "wrangler dev",
    "dev": "vite",
    "build": "vite build && tsc -p tsconfig.worker.json --noEmit",
    "build:frontend": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "cf-typegen": "wrangler types",
    "deploy": "npm run build:frontend && wrangler deploy",
    "d1:migrate:local": "wrangler d1 migrations apply boss-url-db --local",
    "d1:migrate:remote": "wrangler d1 migrations apply boss-url-db --remote"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.0.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250224.0",
    "@types/node": "^22.13.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "vitest": "^3.0.7",
    "wrangler": "^3.111.0"
  }
}
